{
  "manifest_version": 3,
  "name": "Clothes Picker",
  "description": "Выбирай картинки одежды на сайтах магазинов и сохраняй их в расширение",
  "version": "0.1.0",
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clothes Picker"
  },
  "commands": {
    "toggle-picker": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Включить/выключить режим выбора картинок"
    }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
